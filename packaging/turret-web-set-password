#!/usr/bin/env python3
"""Root-only password initialization, retrieval, and rotation for turret-web."""
import argparse
import json
import os
import secrets
import sys
from pathlib import Path

sys.path.insert(0, "/opt/turret-web")
try:
    from auth import password_record
except ImportError:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "backend"))
    from auth import password_record

STATE = Path("/var/lib/turret-web")
AUTH = STATE / "auth.json"
INITIAL = STATE / "initial-password"

def write_private(path, content, mode, group=None):
    temp = path.with_name(path.name + ".tmp." + secrets.token_hex(8))
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.chmod(temp, mode)
        if group is not None:
            os.chown(temp, 0, group)
        os.replace(temp, path)
    finally:
        if temp.exists():
            temp.unlink()

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["init", "show-initial", "rotate"])
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("Run with sudo")
    STATE.mkdir(mode=0o750, parents=True, exist_ok=True)
    import grp
    group = grp.getgrnam("turret-web").gr_gid
    os.chown(STATE, 0, group)
    os.chmod(STATE, 0o750)
    if args.action == "show-initial":
        if not INITIAL.exists():
            parser.error("Initial password no longer available; use rotate")
        print(INITIAL.read_text(encoding="utf-8").strip())
        return
    if args.action == "init" and AUTH.exists():
        print("Existing credentials preserved")
        return
    password = secrets.token_urlsafe(24)
    write_private(AUTH, json.dumps(password_record(password)) + "\n", 0o640, group)
    write_private(INITIAL, password + "\n", 0o600)
    print("Initial password generated. Retrieve locally: sudo turret-web-set-password show-initial")
    if args.action == "rotate":
        print("Password rotated; restart turret-web.service to invalidate existing sessions.")

if __name__ == "__main__":
    main()
