[Unit]
Description=Local Robot Maintenance Web UI
After=network.target

[Service]
Type=simple
User=turret-web
Group=turret-web
EnvironmentFile=-/usr/share/robot/environment/full.env
EnvironmentFile=-/etc/default/turret-web
Environment=ROS_HOME=/var/lib/turret-web/ros
Environment=ROS_LOG_DIR=/var/lib/turret-web/ros
ExecStart=/usr/bin/bash /opt/turret-web/start.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10s
Environment=PYTHONUNBUFFERED=1
StateDirectory=turret-web
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
